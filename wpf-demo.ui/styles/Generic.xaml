<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:wpf.ui.styles"
                    xmlns:devices="clr-namespace:UserComponent.Core.devices;assembly=UserComponent.Core">
    <Style TargetType="TextBlock" x:Key="PageTitle">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="Thin" />
        <Setter Property="Foreground" Value="#333" />
    </Style>

    <Style TargetType="TextBlock" x:Key="FieldTitle">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="Thin" />
        <Setter Property="Foreground" Value="#333" />
    </Style>

    <Style TargetType="TextBlock" x:Key="BlueFieldValue">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="#fff" />
        <Setter Property="Background" Value="DarkBlue" />
    </Style>

    <Style TargetType="TextBlock" x:Key="FieldValue">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="InnerShadowBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="CornerRadius" Value="1"/>
        <Setter Property="Background" Value="#dad9d8"/>

        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#CCCCCC"/>

        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect 
                    Color="#80000000" 
                    Direction="135"
                    ShadowDepth="2"
                    BlurRadius="3"
                    Opacity="0.6"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="devices:BusControl">
        <Setter Property="IsPowered" Value="{Binding PowerOn}" />
    </Style>

    <Style TargetType="devices:TrackControl">
        <Setter Property="IsPowered" Value="{Binding PowerOn}" />
    </Style>

</ResourceDictionary>