<UserControl x:Class="wpf.ui.views.panels.DatetimePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:wpf.ui.views.panels"
             xmlns:viewmodel="clr-namespace:wpf.ui.viewmodels.panels">
    
<UserControl.DataContext>
        <viewmodel:DatetimePanelVm />
</UserControl.DataContext>
        <Canvas Width="1920" Height="1080">
        <Canvas Canvas.Left="1415.44995117188" Canvas.Top="76.75">
            <Canvas>
                <Canvas.Clip>
                    <RectangleGeometry Rect="295.55,-2,198.7,30"/>
                </Canvas.Clip>
                <TextBlock Text="{Binding CurrentDate}" FontSize="26" Foreground="#FF003300" Canvas.Left="298.4" Canvas.Top="-1.05"/>
            </Canvas>
        </Canvas>
        <Canvas Canvas.Left="1430.59997558594" Canvas.Top="106.5">
            <TextBlock Text="{Binding CurrentTime}" FontSize="26" Foreground="#FF003300" Canvas.Left="323.75" Canvas.Top="-1.05">
                <TextBlock.Clip>
                    <StreamGeometry>M-28.2,-0.949999999999999L140.25,-0.949999999999999 140.25,29.05 -28.2,29.05z</StreamGeometry>
                </TextBlock.Clip>
            </TextBlock>
        </Canvas>
    </Canvas>
</UserControl>
