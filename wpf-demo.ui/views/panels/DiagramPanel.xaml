<UserControl x:Class="wpf.ui.views.panels.DiagramPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodel="clr-namespace:wpf.ui.viewmodels.panels"
             xmlns:local="clr-namespace:wpf.ui.views.panels"
             xmlns:converter="clr-namespace:UserComponent.Core.converters;assembly=UserComponent.Core">
    <UserControl.Resources>
        <converter:ImageResourceConverter x:Key="ImageResourceConverter" />
    </UserControl.Resources>
    <UserControl.DataContext>
        <viewmodel:DiagramPanelViewModel></viewmodel:DiagramPanelViewModel>
    </UserControl.DataContext>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid>
                <Image x:Name="imgContent"
               Source="{Binding Path=ImageSource}">
                </Image>
                <ContentControl Content="{Binding CurrentViewModel}"
                ></ContentControl>
            </Grid>
        </ScrollViewer>


    </Grid>
</UserControl>
