<UserControl x:Class="wpf.ui.views.devices.BreakerExecute"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:wpf.ui.views.devices"
             xmlns:btn="clr-namespace:UserComponent.Core.menu;assembly=UserComponent.Core"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors">
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource FieldTitle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Margin" Value="20,0,20,0" />
        </Style>
    </UserControl.Resources>
    <Grid Background="#dad9d8">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="设备详情" Style="{StaticResource PageTitle}"/>
        <Grid Grid.Row="1" Margin="20,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0"
                Text="设备：" Style="{StaticResource FieldTitle}"></TextBlock>
            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="{Binding DisplayName}" 
                       Style="{StaticResource BlueFieldValue}"
                       TextAlignment="Center"
                       Width="400"></TextBlock>
            <TextBlock Grid.Row="1" Grid.Column="0"
                Text="名称：" Style="{StaticResource FieldTitle}"></TextBlock>
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Text="{Binding DeviceName}" 
                       Style="{StaticResource BlueFieldValue}"
                       TextAlignment="Center"
                       Width="400"></TextBlock>
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="车站：" 
                       Style="{StaticResource FieldTitle}"/>
            <TextBlock Grid.Row="2" Grid.Column="1"
                       Text="{Binding StationName}" 
                       Style="{StaticResource BlueFieldValue}"
                       Width="400"></TextBlock>
            <TextBlock Grid.Row="3" Grid.Column="0"
                       Text="当前状态：" 
                       Style="{StaticResource FieldTitle}" />
            <TextBlock Grid.Row="3" Grid.Column="1"
                       Text="{Binding Status}" 
                       Style="{StaticResource BlueFieldValue}"
                       Width="120"></TextBlock>
            <TextBlock Grid.Row="4" Grid.Column="0"
                       Text="目标状态：" 
                       Style="{StaticResource FieldTitle}" />
            <TextBlock Grid.Row="4" Grid.Column="1"
                       Text="{Binding TargetStatus}" 
                       Style="{StaticResource BlueFieldValue}"
                       Width="120"></TextBlock>
        </Grid>
        <StackPanel Grid.Row="2">
            <TextBlock Text="{Binding Message}"
                       Foreground="Red"
                       FontSize="10"
                       Width="200"
                       HorizontalAlignment="Center"></TextBlock>
            <Button 
                Width="160" Height="60" Content="{Binding ActionName}"
                FontSize="22"
                Margin="0, 20"
                Command="{Binding BreakerActionCommand}">
            </Button>
        </StackPanel>

    </Grid>
</UserControl>
