<Window x:Class="wpf.ui.views.dialogs.DevicePopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:wpf.ui.views.dialogs"
        xmlns:vm="clr-namespace:wpf.ui.viewmodels.popup"
        WindowStyle="{Binding WindowStyle}"
        Deactivated="Window_Deactivated"
        SizeToContent="WidthAndHeight"
        Loaded="Window_Loaded">
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
        <ContentControl Content="{Binding DeviceViewModel}">
        </ContentControl>
    </ScrollViewer>
</Window>
