<UserControl x:Class="wpf.ui.views.diagrams.electric.RailPotentialReset"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:wpf.ui.views.diagrams.electric"
             xmlns:vm="clr-namespace:wpf.ui.viewmodels.diagrams.electric"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:ctrl="clr-namespace:wpf.ui.views.diagrams.common"
             xmlns:converter="clr-namespace:wpf.ui.converters"
             xmlns:model="clr-namespace:wpf.ui.model.diagrams.electric">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="HeaderText">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Thin" />
            <Setter Property="Foreground" Value="#333" />
        </Style>

        <Style TargetType="Border" x:Key="ItemBorderStyle">
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="80" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Black" />
        </Style>

        <DataTemplate x:Key="RailPotentialOpenTemplate">
            <StackPanel>
                <Border BorderThickness="1,1,1,0" Style="{StaticResource ItemBorderStyle}">
                    <TextBlock Text="{Binding StationName}"
                    Style="{StaticResource HeaderText}"/>
                </Border>
                <Border BorderThickness="1,1,1,1" Style="{StaticResource ItemBorderStyle}">
                    <Ellipse Width="20" Height="20" 
                             Fill="Yellow" Stroke="Black" 
                             StrokeThickness="0">
                    </Ellipse>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="RailPotentialCloseTemplate">
            <StackPanel>
                <Border BorderThickness="1,1,1,0" Style="{StaticResource ItemBorderStyle}">
                    <TextBlock Text="{Binding StationName}"
                    Style="{StaticResource HeaderText}"/>
                </Border>
                <Border BorderThickness="1,1,1,1" Style="{StaticResource ItemBorderStyle}">
                    <Ellipse Width="20" Height="20" 
                     Fill="Transparent" Stroke="Yellow" 
                             StrokeThickness="2"/>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="RailPotentialFaultTemplate">
            <StackPanel>
                <Border BorderThickness="1,1,1,0" Style="{StaticResource ItemBorderStyle}">
                    <TextBlock Text="{Binding StationName}"
                    Style="{StaticResource HeaderText}"/>
                </Border>
                <Border BorderThickness="1,1,1,1" Style="{StaticResource ItemBorderStyle}">
                    <Grid>
                        <Ellipse Width="20" Height="20" 
                         Fill="Transparent" Stroke="Yellow" StrokeThickness="2"/>
                        <Ellipse Width="16" Height="16" Fill="Pink"/>
                    </Grid>
                </Border>
            </StackPanel>
        </DataTemplate>

        <converter:RailPotentialTemplateSelector 
            x:Key="RailPotentialTemplateSelector"
            OpenTemplate="{StaticResource RailPotentialOpenTemplate}"
            CloseTemplate="{StaticResource RailPotentialCloseTemplate}"
            FaultTemplate="{StaticResource RailPotentialFaultTemplate}"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition Height="260"></RowDefinition>
            <RowDefinition Height="200"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>
        <ctrl:Caption Grid.Row="0" Grid.ColumnSpan="3"
                      FontSize="28"
                      CaptionText="全线轨电位复归">
        </ctrl:Caption>

        <ItemsControl Grid.Row="1" Grid.Column="1"
                      ItemsSource="{Binding TopGridItems}"
                      Margin="0, 20,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplateSelector>
                <StaticResource ResourceKey="RailPotentialTemplateSelector"/>
            </ItemsControl.ItemTemplateSelector>
        </ItemsControl>

        <ItemsControl Grid.Row="2" Grid.Column="1"
                      ItemsSource="{Binding BottomGridItems}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplateSelector>
                <StaticResource ResourceKey="RailPotentialTemplateSelector"/>
            </ItemsControl.ItemTemplateSelector>
        </ItemsControl>
    </Grid>
</UserControl>
