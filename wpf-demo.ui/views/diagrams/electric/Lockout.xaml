<UserControl x:Class="wpf.ui.views.diagrams.electric.Lockout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:wpf.ui.views.diagrams.electric"
             xmlns:vm="clr-namespace:wpf.ui.viewmodels.diagrams.electric"
             xmlns:ctrl="clr-namespace:wpf.ui.views.diagrams.common">
    <UserControl.Resources>
        <Style TargetType="Button" x:Key="LockoutBtn" >
            <Setter Property="Height" Value="60" />
            <Setter Property="Width" Value="400" />
            <Setter Property="Margin" Value="0, 60" />
            <Setter Property="Foreground" Value="#c0bcbc"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Background" Value="#f6f4ee"/>
            <Setter Property="BorderBrush" Value="#ccc"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Tag" Value="6"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border 
                    x:Name="BtnBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding Tag}"
                            SnapsToDevicePixels="True">

                            <ContentPresenter 
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#F5F5F5"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#D0D0D0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#EEEEEE"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#C0C0C0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#F9F9F9"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#F0F0F0"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" ></ColumnDefinition>
            <ColumnDefinition Width="*" ></ColumnDefinition>
            <ColumnDefinition Width="*" ></ColumnDefinition>
            <ColumnDefinition Width="*" ></ColumnDefinition>
            <ColumnDefinition Width="200" ></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <ctrl:Caption Grid.Row="0"
                      Grid.ColumnSpan="5"
                      FontSize="28"
                      StationName="{Binding RouteService.StationName}"
                      CaptionText="闭锁逻辑目录">
        </ctrl:Caption>
        <StackPanel Grid.Row="1" Grid.Column="1">
            <Button Content="750V备用断路器闭锁逻辑" Style="{StaticResource LockoutBtn}"></Button>
            <Button Content="750V进线隔离开关闭锁逻辑" Style="{StaticResource LockoutBtn}"></Button>
            <Button Content="750V SES闭锁逻辑" Style="{StaticResource LockoutBtn}"></Button>
            <Button Content="10kV馈线变压器闭锁逻辑" Style="{StaticResource LockoutBtn}"></Button>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="2">
            <Button Content="750V负极隔离开关闭锁逻辑" Style="{StaticResource LockoutBtn}"></Button>
            <Button Content="750V馈线断路器闭锁逻辑" Style="{StaticResource LockoutBtn}"></Button>
            <Button Content="750V上网隔离开关闭锁逻辑" Style="{StaticResource LockoutBtn}"></Button>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="3">
            <Button Content="750V进线断路器闭锁逻辑" Style="{StaticResource LockoutBtn}"></Button>
            <Button Content="750V馈线旁路隔离开关闭锁逻辑" Style="{StaticResource LockoutBtn}"></Button>
            <Button Content="10kV环网线闭锁逻辑" Style="{StaticResource LockoutBtn}"></Button>
        </StackPanel>
    </Grid>
</UserControl>
