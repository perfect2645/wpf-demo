<UserControl x:Class="wpf.ui.views.diagrams.electric.FullLine"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:wpf.ui.views.diagrams.electric"
             Loaded="UserControl_Loaded">
    <Grid>
        <StackPanel x:Name="imagePanel" Orientation="Horizontal">
            <Image x:Name="FullLineDiagram1"></Image>
            <Image x:Name="FullLineDiagram2"></Image>
            <Image x:Name="FullLineDiagram3"></Image>
            <Image x:Name="FullLineDiagram4"></Image>
        </StackPanel>
    </Grid>
</UserControl>
