                <Grid>
                    <TextBlock Text="差动保护" Style="{StaticResource ContentText}"></TextBlock>
                    <Button Style="{StaticResource InputButton}"></Button>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1"
