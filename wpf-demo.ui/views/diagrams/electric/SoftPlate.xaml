            </Border>
            <Border Grid.Row="10" Grid.Column="1">
                <Grid>
                    <TextBlock Text="过流保护" Style="{StaticResource ContentText}"></TextBlock>
                    <Button Style="{StaticResource InputButton}"></Button>
                </Grid>
            </Border>
            <Border Grid.Row="11" Grid.Column="1">
