            </Border>
            <Border Grid.Row="1" Grid.Column="1">
                <Grid>
                    <TextBlock Text="过流保护" Style="{StaticResource ContentText}"></TextBlock>
                    <Button Style="{StaticResource InputButton}"></Button>
                </Grid>
            </Border>
            <Border Grid.Row="2" Grid.Column="1">
                <Grid>
                    <TextBlock Text="零序过流保护" Style="{StaticResource ContentText}"></TextBlock>
                    <Button Style="{StaticResource InputButton}"></Button>
                </Grid>
            </Border>
            <Border Grid.Row="3" Grid.Column="1">
                <Grid>
                    <TextBlock Text="差动保护" Style="{StaticResource ContentText}"></TextBlock>
                    <Button Style="{StaticResource InputButton}"></Button>
