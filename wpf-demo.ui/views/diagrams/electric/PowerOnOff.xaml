<UserControl x:Class="wpf.ui.views.diagrams.electric.PowerOnOff"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:wpf.ui.views.diagrams.electric"
             xmlns:ctrl="clr-namespace:wpf.ui.views.diagrams.common"
             xmlns:model="clr-namespace:wpf.ui.model.diagrams.electric"
             xmlns:breaker="clr-namespace:wpf.ui.controls.buttons"
             x:Name="PowerOnOffCtrl"
             Background="#dad9d8"
             Padding="4, 0, 4 ,4">
    <UserControl.Resources>
        <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="#aaa" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="TextBlock" x:Key="TitleText">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#333" />
        </Style>
        <Style TargetType="TextBlock" x:Key="ContentText">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#333" />
        </Style>

        <Style TargetType="Button" x:Key="StatusButton">
            <Setter Property="Width" Value="50" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8, 0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="不可控">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="500"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>
        <ctrl:Caption Grid.Row="0"
                      Grid.ColumnSpan="5"
                      FontSize="26"
                      Foreground="{Binding CaptionForeground}"
                      StationName="{Binding RouteService.StationName}"
                      CaptionText="{Binding CaptionText}">
        </ctrl:Caption>
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
            <TextBlock  Text="开关"
                        Style="{StaticResource TitleText}"></TextBlock>
        </Border>
        <Border Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2"
                BorderThickness="0,1,1,1">
            <TextBlock  Text="状态" Style="{StaticResource TitleText}"></TextBlock>
        </Border>

        <Border Grid.Row="2" Grid.Column="0"  Grid.ColumnSpan="3"
                BorderThickness="0,0,1,0" />
        <Border Grid.Row="2" Grid.Column="0"
                BorderThickness="0,0,1,0" />
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
                BorderThickness="1,0,1,1">
            <ItemsControl ItemsSource="{Binding ItemSource}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type model:PowerOnOffItem}">
                        <Grid Height="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock 
                            Grid.Column="0" 
                            Text="{Binding BreakerName}" 
                            Style="{StaticResource ContentText}"
                            HorizontalAlignment="Right"
                            Margin="8"/>

                            <breaker:BreakerButton Grid.Column="1" 
                                Width="16"
                                Height="26"
                                BreakerState="{Binding BreakerState1}"
                                BreakerType="{Binding BreakerType1}"
                                Background="{Binding Background1}"
                                BorderBrush="{Binding BorderBrush1}"
                                VerticalAlignment="Center" 
                                Margin="5"/>

                            <breaker:BreakerButton Grid.Column="2" 
                                Width="16"
                                Height="26"
                                BreakerState="{Binding BreakerState2}"
                                BreakerType="{Binding BreakerType2}"
                                Background="{Binding Background2}"
                                BorderBrush="{Binding BorderBrush2}"
                                VerticalAlignment="Center" 
                                Margin="5"/>

                            <Button Grid.Column="3" 
                                Style="{StaticResource StatusButton}"
                                Content="{Binding Status}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>
