<UserControl x:Class="wpf.ui.views.diagrams.electric.Power750Popup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:wpf.ui.views.diagrams.electric"
             xmlns:ctrl="clr-namespace:wpf.ui.views.diagrams.common"
             xmlns:model="clr-namespace:wpf.ui.model.diagrams.electric"
             Background="#ccc">
    <UserControl.Resources>

        <Style TargetType="TextBlock" x:Key="HeaderText">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <DataTemplate x:Key="ItemTemplate" DataType="{x:Type model:Power750StationSelect}">
            <StackPanel Orientation="Horizontal">
                <Border Width="200" Height="30"
                    BorderThickness="0.5"
                    BorderBrush="Black">
                    <TextBlock Text="{Binding StationName}"
                               Style="{StaticResource HeaderText}"></TextBlock>
                </Border>
                <Border Width="200" Height="30"
                        BorderThickness="0.5"
                        BorderBrush="Black">
                    <CheckBox IsChecked="{Binding IsChecked}"
                              FontSize="20"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"></CheckBox>
                </Border>
            </StackPanel>
        </DataTemplate>

        <Style TargetType="Button" x:Key="ActionButton" >
            <Setter Property="Height" Value="60" />
            <Setter Property="Width" Value="100" />
            <Setter Property="Foreground" Value="#403791"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Background" Value="#aaa"/>
            <Setter Property="BorderBrush" Value="#ccc"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Tag" Value="6"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border 
                    x:Name="BtnBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding Tag}"
                            SnapsToDevicePixels="True">

                            <ContentPresenter 
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#F5F5F5"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#D0D0D0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#EEEEEE"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#C0C0C0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#F9F9F9"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#F0F0F0"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ctrl:Caption Grid.Row="0"
                      FontSize="28"
                      Foreground="{Binding TitleForeGround}"
                      CaptionText="{Binding Title}">
        </ctrl:Caption>

        <Grid Grid.Row="1" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    BorderBrush="Black"
                    BorderThickness="1">
                <TextBlock Text="站名" Style="{StaticResource HeaderText}"/>
            </Border>

            <Border Grid.Column="1"
                    BorderBrush="Black"
                    BorderThickness="1">
                <TextBlock Text="选择" Style="{StaticResource HeaderText}" />
            </Border>
        </Grid>

        <ItemsControl Grid.Row="2" Width="400"
                    ItemsSource="{Binding Stations}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ContentPresenter ContentTemplate="{StaticResource ItemTemplate}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Grid.Row="3"
                    Height="100">
            <TextBlock Width="100" Text="序列名称:" Style="{StaticResource HeaderText}"
                       Foreground="#403791"/>
            <TextBlock Width="100" Text="" Style="{StaticResource HeaderText}"
                      Foreground="#403791"/>
            <Button Style="{StaticResource ActionButton}"
                    Command="{Binding StartCommand}"
                    Content="开始">
            </Button>
            <Button Style="{StaticResource ActionButton}"
                    Command="{Binding RetryCommand}"
                    Content="重试">
            </Button>
            <Button Style="{StaticResource ActionButton}"
                    Command="{Binding SkipCommand}"
                    Content="跳过">
            </Button>
            <Button Style="{StaticResource ActionButton}"
                    Command="{Binding ExecuteCommand}"
                    Content="执行"
                    Margin="30 0 0 0">
            </Button>
            <Button Style="{StaticResource ActionButton}"
                    Command="{Binding CancelCommand}"
                    Content="取消">
            </Button>
            <Button Style="{StaticResource ActionButton}"
                    Command="{Binding StopCommand}"
                    Background="Red"
                    Content="中止">
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
