<UserControl x:Class="wpf.ui.views.diagrams.electric.StationPrimarySystem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:wpf.ui.views.diagrams.electric"
             xmlns:views="clr-namespace:wpf.ui.views.diagrams.electric.primary"
             xmlns:converter="clr-namespace:WpfUtils.Converters;assembly=WpfUtils"
             xmlns:popup="clr-namespace:WpfWidgets.popup;assembly=WpfWidgets">
    <UserControl.Resources>
    </UserControl.Resources>
    <Grid>
        <ContentControl Content="{Binding CurrentViewModel}"></ContentControl>
        <Canvas>
            <popup:NotificationBar Canvas.Left="794" Canvas.Top="50"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Background="{Binding TrackNotificationBackground}"
                        FontSize="24"
                        MessageQueue="{Binding TrackMessageQueue}">
            </popup:NotificationBar>
        </Canvas>
    </Grid>
</UserControl>
