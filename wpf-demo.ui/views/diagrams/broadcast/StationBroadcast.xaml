<UserControl x:Class="wpf.ui.views.diagrams.broadcast.StationBroadcast"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:wpf.ui.views.diagrams.electric"
             xmlns:vm="clr-namespace:wpf.ui.viewmodels.diagrams.electric"
             xmlns:ctrl="clr-namespace:wpf.ui.views.diagrams.common">
    <UserControl.Resources>
        
    </UserControl.Resources>
    <Grid HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" ></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <ctrl:Caption Grid.Row="0"
                      FontSize="26"
                      Foreground="{Binding CaptionForeground}"
                      StationName="{Binding RouteService.StationName}">
        </ctrl:Caption>
        <Grid Grid.Row="2" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" ></ColumnDefinition>
                <ColumnDefinition Width="30" ></ColumnDefinition>
                <ColumnDefinition Width="Auto" ></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Border Grid.Row="0" Grid.Column="0" BorderBrush="Black" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"></RowDefinition>
                        <RowDefinition Height="50"></RowDefinition>
                        <RowDefinition Height="50"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" ></ColumnDefinition>
                        <ColumnDefinition Width="150" ></ColumnDefinition>
                        <ColumnDefinition Width="150" ></ColumnDefinition>
                        <ColumnDefinition Width="150" ></ColumnDefinition>
                        <ColumnDefinition Width="150" ></ColumnDefinition>
                        <ColumnDefinition Width="150" ></ColumnDefinition>
                        <ColumnDefinition Width="150" ></ColumnDefinition>
                        <ColumnDefinition Width="150" ></ColumnDefinition>
                        <ColumnDefinition Width="150" ></ColumnDefinition>
                        <ColumnDefinition Width="150" ></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Content="全车站" FontSize="20" Width="100" Height="80" Foreground="Black"></Button>
                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="Black" BorderThickness="0,1,0,0">
                        <TextBlock Text="设备状态" FontSize="20" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                    </Border>

                    <Label Grid.Row="0" Grid.Column="1" Content="上行站台" FontSize="20" Foreground="White" Background="Blue" Width="150" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                    <Label Grid.Row="1" Grid.Column="1" Background="Silver" Width="100" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="Black" BorderThickness="0,1,0,0">
                        <Label Background="Green" Width="100" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                    </Border>
                    
                    <Label Grid.Row="0" Grid.Column="2" Content="下行站台" FontSize="20" Foreground="White" Background="Blue" Width="150" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                    <Label Grid.Row="1" Grid.Column="2" Background="Silver" Width="100" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                    <Border Grid.Row="2" Grid.Column="2" BorderBrush="Black" BorderThickness="0,1,0,0">
                        <Label Background="Green" Width="100" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                    </Border>

                    <Label Grid.Row="0" Grid.Column="3" Content="站厅" FontSize="20" Foreground="White" Background="Blue" Width="150" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                    <Label Grid.Row="1" Grid.Column="3" Background="Silver" Width="100" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                    <Border Grid.Row="2" Grid.Column="3" BorderBrush="Black" BorderThickness="0,1,0,0">
                        <Label Background="Green" Width="100" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                    </Border>

                    <Label Grid.Row="0" Grid.Column="4" Content="办公区1" FontSize="20" Foreground="White" Background="Blue" Width="150" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                    <Label Grid.Row="1" Grid.Column="4" Background="Silver" Width="100" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                    <Border Grid.Row="2" Grid.Column="4" BorderBrush="Black" BorderThickness="0,1,0,0">
                        <Label Background="Green" Width="100" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                    </Border>

                    <Label Grid.Row="0" Grid.Column="5" Content="办公区2" FontSize="20" Foreground="White" Background="Blue" Width="150" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                    <Label Grid.Row="1" Grid.Column="5" Background="Silver" Width="100" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                    <Border Grid.Row="2" Grid.Column="5" BorderBrush="Black" BorderThickness="0,1,0,0">
                        <Label Background="Green" Width="100" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                    </Border>

                    <Label Grid.Row="0" Grid.Column="6" Content="上隧道1" FontSize="20" Foreground="White" Background="Blue" Width="150" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                    <Label Grid.Row="1" Grid.Column="6" Background="Silver" Width="100" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                    <Border Grid.Row="2" Grid.Column="6" BorderBrush="Black" BorderThickness="0,1,0,0">
                        <Label Background="Green" Width="100" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                    </Border>

                    <Label Grid.Row="0" Grid.Column="7" Content="上隧道2" FontSize="20" Foreground="White" Background="Blue" Width="150" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                    <Label Grid.Row="1" Grid.Column="7" Background="Silver" Width="100" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                    <Border Grid.Row="2" Grid.Column="7" BorderBrush="Black" BorderThickness="0,1,0,0">
                        <Label Background="Green" Width="100" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                    </Border>

                    <Label Grid.Row="0" Grid.Column="8" Content="下隧道1" FontSize="20" Foreground="White" Background="Blue" Width="150" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                    <Label Grid.Row="1" Grid.Column="8" Background="Silver" Width="100" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                    <Border Grid.Row="2" Grid.Column="8" BorderBrush="Black" BorderThickness="0,1,0,0">
                        <Label Background="Green" Width="100" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                    </Border>

                    <Label Grid.Row="0" Grid.Column="9" Content="下隧道2" FontSize="20" Foreground="White" Background="Blue" Width="150" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                    <Label Grid.Row="1" Grid.Column="9" Background="Silver" Width="100" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                    <Border Grid.Row="2" Grid.Column="9" BorderBrush="Black" BorderThickness="0,1,0,0">
                        <Label Background="Green" Width="100" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="0" Grid.Column="2" BorderBrush="Black" BorderThickness="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" ></ColumnDefinition>
                        <ColumnDefinition Width="Auto" ></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Background="Blue" Height="30" Width="60" Margin="10,10,0,0"></Label>
                    <Label Grid.Row="1" Grid.Column="0" Background="Yellow" Height="30" Width="60" Margin="10,10,0,0"></Label>
                    <Label Grid.Row="2" Grid.Column="0" Background="Red" Height="30" Width="60" Margin="10,10,0,0"></Label>
                    <Label Grid.Row="3" Grid.Column="0" Background="Green" Height="30" Width="60" Margin="10,10,0,0"></Label>
                    <Label Grid.Row="4" Grid.Column="0" Background="Orange" Height="30" Width="60" Margin="10,10,0,10"></Label>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="火灾占用" FontSize="20" Foreground="Black" Margin="10,10,10,0"></TextBlock>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="其他占用" FontSize="20" Foreground="Black" Margin="10,10,10,0"></TextBlock>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="报警" FontSize="20" Foreground="Black" Margin="10,10,10,0"></TextBlock>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="正常" FontSize="20" Foreground="Black" Margin="10,10,10,0"></TextBlock>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="选定" FontSize="20" Foreground="Black" Margin="10,10,10,10"></TextBlock>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Grid.Column="0" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" ></ColumnDefinition>
                <ColumnDefinition Width="30" ></ColumnDefinition>
                <ColumnDefinition Width="Auto" ></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Border Grid.Row="0" Grid.Column="0" BorderBrush="Black" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"></RowDefinition>
                        <RowDefinition Height="50"></RowDefinition>
                        <RowDefinition Height="50"></RowDefinition>
                        <RowDefinition Height="50"></RowDefinition>
                        <RowDefinition Height="50"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" ></ColumnDefinition>
                        <ColumnDefinition Width="100" ></ColumnDefinition>
                        <ColumnDefinition Width="200" ></ColumnDefinition>
                        <ColumnDefinition Width="100" ></ColumnDefinition>
                        <ColumnDefinition Width="300" ></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Content="语音广播" FontSize="20" Foreground="White" Background="Blue" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"></Label>
                    <Border Background="Blue" Grid.Row="0" Grid.Column="4">
                        <Label Content="执行" FontSize="20" Foreground="Black" Background="Silver" HorizontalAlignment="Right" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="100" Height="35"></Label>
                    </Border>

                    <TextBlock Grid.Row="1" Grid.Column="1" Text="语音号" FontSize="20" Foreground="Black" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="语音描述" FontSize="20" Foreground="Black" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
                    <Label Grid.Row="1" Grid.Column="3" Content="内容" FontSize="20" Foreground="White" Background="Blue" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="35"></Label>
                    <TextBox Grid.Row="1" Grid.Column="4" Grid.RowSpan="4" Text="预留内容。" BorderBrush="Black" BorderThickness="1" Margin="5" IsEnabled="False"></TextBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="选择语音" FontSize="20" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                    <Label Grid.Row="2" Grid.Column="1" Content="0" FontSize="20" Foreground="Black" Background="Silver" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"></Label>
                    <Label Grid.Row="2" Grid.Column="2" Content="预留" FontSize="20" Foreground="Black" Background="Silver" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"></Label>

                    <Border Grid.Row="3" Grid.Column="0" BorderBrush="Black" BorderThickness="1,1,0,0" Margin="5,5,0,0">
                        <Label Content="一次" FontSize="20" Foreground="Black" Background="Orange" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="100" Height="35"></Label>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" BorderBrush="Black" BorderThickness="0,1,1,0" Margin="0,5,5,0">
                        <TextBlock Text="间距（分）：" FontSize="20" Foreground="Black" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
                    </Border>

                    <Border Grid.Row="4" Grid.Column="0" BorderBrush="Black" BorderThickness="1,0,0,1" Margin="5,0,0,5">
                        <Label Content="多次" FontSize="20" Foreground="Black" Background="Silver" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="100" Height="35"></Label>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" BorderBrush="Black" BorderThickness="0,0,1,1" Margin="0,0,5,5">
                        <TextBlock Text="结束时间（时：分）      ：" FontSize="20" Foreground="Black" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="0" Grid.Column="2" BorderBrush="Black" BorderThickness="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"></RowDefinition>
                        <RowDefinition Height="50"></RowDefinition>
                        <RowDefinition Height="50"></RowDefinition>
                        <RowDefinition Height="50"></RowDefinition>
                        <RowDefinition Height="50"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" ></ColumnDefinition>
                        <ColumnDefinition Width="Auto" ></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Content="实时广播" FontSize="20" Foreground="White" Background="Blue" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="5,5,0,0"></Label>
                    <Label Grid.Row="2" Grid.Column="0" Content="线路广播" FontSize="20" Foreground="White" Background="Blue" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="5,5,0,0"></Label>
                    <Label Grid.Row="4" Grid.Column="0" Content="实时监听" FontSize="20" Foreground="White" Background="Blue" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="5,5,0,5"></Label>
                    <Border Background="Blue" Grid.Row="0" Grid.Column="1" Margin="0,5,5,0" Width="60">
                        <Label Content="执行" FontSize="20" Foreground="Black" Background="Silver" Height="35" Width="50"></Label>
                    </Border>
                    <Border Background="Blue" Grid.Row="2" Grid.Column="1" Margin="0,5,5,0" Width="60">
                        <Label Content="执行" FontSize="20" Foreground="Black" Background="Silver" Height="35" Width="50"></Label>
                    </Border>
                    <Border Background="Blue" Grid.Row="4" Grid.Column="1" Margin="0,5,5,5" Width="60">
                        <Label Content="监听" FontSize="20" Foreground="Black" Background="Silver" Height="35" Width="50"></Label>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
