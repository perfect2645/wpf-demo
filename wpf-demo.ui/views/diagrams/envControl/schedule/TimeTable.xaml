<UserControl x:Class="wpf.ui.views.diagrams.envControl.schedule.TimeTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:wpf.ui.views.diagrams.electric"
             xmlns:vm="clr-namespace:wpf.ui.viewmodels.diagrams.electric"
             xmlns:ctrl="clr-namespace:wpf.ui.views.diagrams.common">
    <UserControl.Resources>

    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" ></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" FontSize="28" Text="一周车站时间表定期查看" Foreground="Black" HorizontalAlignment="Center" Margin="0,20,0,0"></TextBlock>
        <Grid Grid.Row="1" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" ></ColumnDefinition>
                <ColumnDefinition Width="Auto" ></ColumnDefinition>
                <ColumnDefinition Width="Auto" ></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Border Grid.Row="0" Grid.Column="0" BorderBrush="Blue" BorderThickness="1" Width="300">
                <Label FontSize="20" Content="时间表" Foreground="White" Background="Blue" HorizontalContentAlignment="Center" Width="300"></Label>
            </Border>
            <Border Grid.Row="0" Grid.Column="1" BorderBrush="Blue" BorderThickness="1" Width="100">
                <Label FontSize="20" Content="版本" Foreground="White" Background="Blue" HorizontalContentAlignment="Center" Width="100"></Label>
            </Border>
            <Border Grid.Row="1" Grid.Column="0" BorderBrush="Black" BorderThickness="1,1,0,1" Height="60">
                <TextBox Text="07    jd(7.1-9.15)" FontSize="20" Width="250" IsReadOnly="True" VerticalContentAlignment="Center" Height="50"></TextBox>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" BorderBrush="Black" BorderThickness="0,1,1,1" Height="60">
                <TextBox Text="16" IsReadOnly="True" FontSize="20" Width="80" VerticalContentAlignment="Center" Height="50"></TextBox>
            </Border>
            <TextBox Grid.Row="1" Grid.Column="2" Text="正常" IsReadOnly="True" VerticalContentAlignment="Center" Margin="10,0,0,0" Width="200" Height="30"></TextBox>
        </Grid>
        <Grid Grid.Row="2" HorizontalAlignment="Center" Margin="0,30,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" ></ColumnDefinition>
                <ColumnDefinition Width="Auto" ></ColumnDefinition>
                <ColumnDefinition Width="Auto" ></ColumnDefinition>
                <ColumnDefinition Width="Auto" ></ColumnDefinition>
                <ColumnDefinition Width="Auto" ></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <DataGrid Grid.Row="0" Grid.Column="0" Grid.RowSpan="21" Grid.ColumnSpan="4" x:Name="TimeTableDataGrid" ItemsSource="{Binding ItemSource}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" IsEnabled="False" BorderBrush="Black" BorderThickness="1" GridLinesVisibility="None">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="编号" Binding="{Binding Id}" FontSize="20" Width="50"/>
                    <DataGridTextColumn Header="类集" Binding="{Binding Category}" FontSize="20" Width="200"/>
                    <DataGridTextColumn Header="时间" Binding="{Binding Time}" FontSize="20" Width="80"/>
                    <DataGridTextColumn Header="模式" Binding="{Binding Mode}" FontSize="20" Width="500"/>
                </DataGrid.Columns>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="White"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Blue"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="20"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
            </DataGrid>
            <Button Grid.Row="0" Grid.Column="4" Content="上一页" FontSize="20" Foreground="Black" IsEnabled="{Binding CanPreviousPageButtonClick}" Command="{Binding PreviousPageClickCommand}" Margin="80,0,0,0" Height="30" Width="100"></Button>
            <Button Grid.Row="9" Grid.Column="4" Content="更新" FontSize="20" Foreground="Black" IsEnabled="False" Margin="80,0,0,0" Height="30" Width="100"></Button>
            <Button Grid.Row="20" Grid.Column="4" Content="下一页" FontSize="20" Foreground="Black" IsEnabled="{Binding CanNextPageButtonClick}" Command="{Binding NextPageClickCommand}" Margin="80,0,0,0" Height="30" Width="100"></Button>
        </Grid>
    </Grid>
</UserControl>
