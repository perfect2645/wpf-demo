<UserControl x:Class="wpf.ui.views.diagrams.envControl.schedule.Schedule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:wpf.ui.views.diagrams.electric"
             xmlns:vm="clr-namespace:wpf.ui.viewmodels.diagrams.electric"
             xmlns:ctrl="clr-namespace:wpf.ui.views.diagrams.common">
    <UserControl.Resources>
        
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" ></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" FontSize="28" Text="一周车站时间表定期查看" Foreground="Black" HorizontalAlignment="Center" Margin="0,20,0,0"></TextBlock>
        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="2" Width="800">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="80"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" ></ColumnDefinition>
                    <ColumnDefinition Width="*" ></ColumnDefinition>
                    <ColumnDefinition Width="*" ></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" FontSize="20" Text="车站控制时间表" Foreground="Black"></TextBlock>
                <Label Grid.Row="1" Grid.Column="1" FontSize="20" Content="每        下载" Foreground="White" Background="Blue"></Label>
                <Border Grid.Row="2" Grid.Column="1" BorderBrush="Black" BorderThickness="1,1,1,0">
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text=" 星期一 " FontSize="20" Foreground="Black"></TextBlock>
                        <TextBox Text="07  jd(7.1-9.15)" IsReadOnly="True" Width="200" VerticalContentAlignment="Center"></TextBox>
                    </StackPanel>
                </Border>
                <Border Grid.Row="3" Grid.Column="1" BorderBrush="Black" BorderThickness="1,0,1,0">
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text=" 星期二 " FontSize="20" Foreground="Black"></TextBlock>
                        <TextBox Text="07  jd(7.1-9.15)" IsReadOnly="True" Width="200" VerticalContentAlignment="Center"></TextBox>
                    </StackPanel>
                </Border>
                <Border Grid.Row="4" Grid.Column="1" BorderBrush="Black" BorderThickness="1,0,1,0">
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text=" 星期三 " FontSize="20" Foreground="Black"></TextBlock>
                        <TextBox Text="07  jd(7.1-9.15)" IsReadOnly="True" Width="200" VerticalContentAlignment="Center"></TextBox>
                    </StackPanel>
                </Border>
                <Border Grid.Row="5" Grid.Column="1" BorderBrush="Black" BorderThickness="1,0,1,0">
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text=" 星期四 " FontSize="20" Foreground="Black"></TextBlock>
                        <TextBox Text="07  jd(7.1-9.15)" IsReadOnly="True" Width="200" VerticalContentAlignment="Center"></TextBox>
                    </StackPanel>
                </Border>
                <Border Grid.Row="6" Grid.Column="1" BorderBrush="Black" BorderThickness="1,0,1,0">
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text=" 星期五 " FontSize="20" Foreground="Black"></TextBlock>
                        <TextBox Text=" - None -中" IsReadOnly="True" Width="200" VerticalContentAlignment="Center"></TextBox>
                    </StackPanel>
                </Border>
                <Border Grid.Row="7" Grid.Column="1" BorderBrush="Black" BorderThickness="1,0,1,0">
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text=" 星期六 " FontSize="20" Foreground="Black"></TextBlock>
                        <TextBox Text=" - None -中" IsReadOnly="True" Width="200" VerticalContentAlignment="Center"></TextBox>
                    </StackPanel>
                </Border>
                <Border Grid.Row="8" Grid.Column="1" BorderBrush="Black" BorderThickness="1,0,1,1">
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                        <TextBlock Text=" 星期日 " FontSize="20" Foreground="Black"></TextBlock>
                        <TextBox Text=" - None -中" IsReadOnly="True" Width="200" VerticalContentAlignment="Center"></TextBox>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="2" BorderBrush="Black" BorderThickness="2" Margin="0,20,0,0" Width="800">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"></RowDefinition>
                    <RowDefinition Height="50"></RowDefinition>
                    <RowDefinition Height="30"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" ></ColumnDefinition>
                    <ColumnDefinition Width="*" ></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" FontSize="20" Text="查看时间表" Foreground="Black"></TextBlock>
                <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1">
                    <TextBlock Text="时间表：" FontSize="20" Foreground="Black" VerticalAlignment="Center"></TextBlock>
                    <TextBox IsReadOnly="True" Width="250" Height="20" VerticalAlignment="Center"></TextBox>
                    <Button Background="Black" Width="20" Height="20" Margin="10,0,0,0" VerticalAlignment="Center"></Button>
                    <Button Content="查看" Width="100" Height="40" FontSize="20" Foreground="Black" Margin="80,0,0,0" VerticalAlignment="Center" IsEnabled="False"></Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
