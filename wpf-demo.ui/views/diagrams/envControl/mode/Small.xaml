                <ColumnDefinition Width="210" ></ColumnDefinition>
                <ColumnDefinition Width="160" ></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button Grid.Row="4" Grid.Column="0" Content="火灾模式" FontSize="15" Foreground="Black" Width="200" Height="30" Command="{Binding ClickCommand}" CommandParameter="环控-模式"></Button>
            <Button Grid.Row="4" Grid.Column="1" Content="空调大系统，水系统" FontSize="15" Foreground="Black" Margin="10,0,0,0" Width="200" Height="30" Command="{Binding ClickCommand}" CommandParameter="模式-大/水"></Button>
            <Button Grid.Row="4" Grid.Column="2" Content="空调小系统" FontSize="15" Foreground="Black" Margin="10,0,0,0" Width="200" Height="30" Background="Orange"></Button>
            <Button Grid.Row="3" Grid.Column="3" Content="南端空调小系统模式表" FontSize="15" Foreground="Black" Margin="10,0,0,0" Width="200" Height="30" Command="{Binding ClickCommand}" CommandParameter=""></Button>
            <Button Grid.Row="4" Grid.Column="3" Content="动照，电扶梯系统" FontSize="15" Foreground="Black" Margin="10,0,0,0" Width="200" Height="30" Command="{Binding ClickCommand}" CommandParameter="模式-电力"></Button>
            <Button Grid.Row="2" Grid.Column="4" Content="北端模式" FontSize="15" Foreground="Black" Margin="10,0,0,0" Width="200" Height="30" Command="{Binding ClickCommand}" CommandParameter=""></Button>
            <Button Grid.Row="3" Grid.Column="4" Content="南端空调小系统图" FontSize="15" Foreground="Black" Margin="10,0,0,0" Width="200" Height="30" Command="{Binding ClickCommand}" CommandParameter=""></Button>
            <Button Grid.Row="4" Grid.Column="4" Content="区间阻塞模式" FontSize="15" Foreground="Black" Margin="10,0,0,0" Width="200" Height="30" Command="{Binding ClickCommand}" CommandParameter="模式-区间"></Button>

            <Border Grid.Row="1" Grid.Column="5" Grid.RowSpan="4" BorderBrush="Black" BorderThickness="1" Margin="30,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" ></ColumnDefinition>
                        <ColumnDefinition Width="Auto" ></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="备注" FontSize="15" Foreground="Black" Margin="10,10,0,0"></TextBlock>
                    <Label Grid.Row="1" Grid.Column="0" Background="Black" Height="20" Width="20" Margin="10,10,0,0"></Label>
                    <Label Grid.Row="2" Grid.Column="0" Background="LightBlue" Height="20" Width="20" Margin="10,10,0,0"></Label>
                    <Label Grid.Row="3" Grid.Column="0" Background="Black" Height="20" Width="20" Margin="10,10,0,0"></Label>
                    <Label Grid.Row="4" Grid.Column="0" Background="White" Height="20" Width="20" Margin="10,10,0,10"></Label>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="进行中" FontSize="15" Foreground="Black" Margin="10,10,0,0"></TextBlock>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="启动成功" FontSize="15" Foreground="Black" Margin="10,10,0,0"></TextBlock>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="启动失败" FontSize="15" Foreground="Black" Margin="10,10,0,0"></TextBlock>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="不运行" FontSize="15" Foreground="Black" Margin="10,10,0,10"></TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
