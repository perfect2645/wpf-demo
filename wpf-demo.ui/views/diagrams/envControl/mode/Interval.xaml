<UserControl x:Class="wpf.ui.views.diagrams.envControl.mode.Interval"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:wpf.ui.views.diagrams.electric"
             xmlns:vm="clr-namespace:wpf.ui.viewmodels.diagrams.electric"
             xmlns:ctrl="clr-namespace:wpf.ui.views.diagrams.common">
    <UserControl.Resources>
        
    </UserControl.Resources>
    <Grid HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="800" ></ColumnDefinition>
            <ColumnDefinition Width="10" ></ColumnDefinition>
            <ColumnDefinition Width="400" ></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <ctrl:Caption Grid.Row="0"
                      FontSize="26"
                      Grid.ColumnSpan="3"
                      Foreground="{Binding CaptionForeground}"
                      StationName="{Binding RouteService.StationName}"
                      CaptionText="区间阻塞模式">
        </ctrl:Caption>
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="100"></RowDefinition>
                <RowDefinition Height="40"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" ></ColumnDefinition>
                <ColumnDefinition Width="50" ></ColumnDefinition>
                <ColumnDefinition Width="250" ></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label Grid.Row="1" Grid.Column="0" Content="蒲黄榆-天坛东门                 工况" FontSize="20" Foreground="White" Background="Blue" ></Label>
            <Border Grid.Row="2" Grid.Column="0" BorderBrush="Black" BorderThickness="1,0,1,0">
                <Label Content="049001 蒲黄榆-天坛东门 左线 靠蒲黄榆" FontSize="20" Foreground="Black" Background="White" Width="480" Height="40"></Label>
            </Border>
            <Border Grid.Row="3" Grid.Column="0" BorderBrush="Black" BorderThickness="1,0,1,0">
                <Label Content="049002 蒲黄榆-天坛东门 左线 靠右" FontSize="20" Foreground="Black" Background="White" Width="480" Height="40"></Label>
            </Border>
            <Border Grid.Row="4" Grid.Column="0" BorderBrush="Black" BorderThickness="1,0,1,0">
                <Label Content="049003 蒲黄榆-天坛东门 右线 靠左" FontSize="20" Foreground="Black" Background="White" Width="480" Height="40"></Label>
            </Border>
            <Border Grid.Row="5" Grid.Column="0" BorderBrush="Black" BorderThickness="1,0,1,1">
                <Label Content="049004 蒲黄榆-天坛东门 右线 靠右" FontSize="20" Foreground="Black" Background="White" Width="480" Height="40"></Label>
            </Border>
            <Label Grid.Row="1" Grid.Column="1" Content="状态" FontSize="20" Foreground="White" Background="Blue" VerticalContentAlignment="Center"></Label>
            <Border Grid.Row="2" Grid.Column="1" BorderBrush="Black" BorderThickness="1,0,1,0">
                <Label Background="White" Width="40" Height="40"></Label>
            </Border>
            <Border Grid.Row="3" Grid.Column="1" BorderBrush="Black" BorderThickness="1,0,1,0">
                <Label Background="White" Width="40" Height="40"></Label>
            </Border>
            <Border Grid.Row="4" Grid.Column="1" BorderBrush="Black" BorderThickness="1,0,1,0">
                <Label Background="White" Width="40" Height="40"></Label>
            </Border>
            <Border Grid.Row="5" Grid.Column="1" BorderBrush="Black" BorderThickness="1,0,1,1">
                <Label Background="White" Width="40" Height="40"></Label>
            </Border>
            <Label Grid.Row="1" Grid.Column="2" Content="阻塞清除" FontSize="15" Foreground="White" Background="Blue" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"></Label>
            <Border Grid.Row="2" Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,1,0">
                <Button Content="清除" FontSize="15" Foreground="Black" BorderBrush="Black" BorderThickness="1" Width="100" Height="40"></Button>
            </Border>
            <Border Grid.Row="3" Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,1,0">
                <Button Content="清除" FontSize="15" Foreground="Black" BorderBrush="Black" BorderThickness="1" Width="100" Height="40"></Button>
            </Border>
            <Border Grid.Row="4" Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,1,0">
                <Button Content="清除" FontSize="15" Foreground="Black" BorderBrush="Black" BorderThickness="1" Width="100" Height="40"></Button>
            </Border>
            <Border Grid.Row="5" Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,1,1">
                <Button Content="清除" FontSize="15" Foreground="Black" BorderBrush="Black" BorderThickness="1" Width="100" Height="40"></Button>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"></RowDefinition>
                <RowDefinition Height="40"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" ></ColumnDefinition>
                <ColumnDefinition Width="50" ></ColumnDefinition>
                <ColumnDefinition Width="250" ></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label Grid.Row="1" Grid.Column="0" Content="天坛东门-磁器口                 工况" FontSize="20" Foreground="White" Background="Blue"></Label>
            <Border Grid.Row="2" Grid.Column="0" BorderBrush="Black" BorderThickness="1,0,1,0">
                <Label Content="049005 天坛东门-磁器口 左线 靠左" FontSize="20" Foreground="Black" Background="White" Width="480" Height="40"></Label>
            </Border>
            <Border Grid.Row="3" Grid.Column="0" BorderBrush="Black" BorderThickness="1,0,1,0">
                <Label Content="049006 天坛东门-磁器口 左线 靠右" FontSize="20" Foreground="Black" Background="White" Width="480" Height="40"></Label>
            </Border>
            <Border Grid.Row="4" Grid.Column="0" BorderBrush="Black" BorderThickness="1,0,1,0">
                <Label Content="049007 天坛东门-磁器口 右线 靠左" FontSize="20" Foreground="Black" Background="White" Width="480" Height="40"></Label>
            </Border>
            <Border Grid.Row="5" Grid.Column="0" BorderBrush="Black" BorderThickness="1,0,1,1">
                <Label Content="049008 天坛东门-磁器口 右线 靠右" FontSize="20" Foreground="Black" Background="White" Width="480" Height="40"></Label>
            </Border>
            <Label Grid.Row="1" Grid.Column="1" Content="状态" FontSize="20" Foreground="White" Background="Blue" VerticalContentAlignment="Center"></Label>
            <Border Grid.Row="2" Grid.Column="1" BorderBrush="Black" BorderThickness="1,0,1,0">
                <Label Background="White" Width="40" Height="40"></Label>
            </Border>
            <Border Grid.Row="3" Grid.Column="1" BorderBrush="Black" BorderThickness="1,0,1,0">
                <Label Background="White" Width="40" Height="40"></Label>
            </Border>
            <Border Grid.Row="4" Grid.Column="1" BorderBrush="Black" BorderThickness="1,0,1,0">
                <Label Background="White" Width="40" Height="40"></Label>
            </Border>
            <Border Grid.Row="5" Grid.Column="1" BorderBrush="Black" BorderThickness="1,0,1,1">
                <Label Background="White" Width="40" Height="40"></Label>
            </Border>
            <Label Grid.Row="1" Grid.Column="2" Content="阻塞清除" FontSize="15" Foreground="White" Background="Blue" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"></Label>
            <Border Grid.Row="2" Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,1,0">
                <Button Content="清除" FontSize="15" Foreground="Black" BorderBrush="Black" BorderThickness="1" Width="100" Height="40"></Button>
            </Border>
            <Border Grid.Row="3" Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,1,0">
                <Button Content="清除" FontSize="15" Foreground="Black" BorderBrush="Black" BorderThickness="1" Width="100" Height="40"></Button>
            </Border>
            <Border Grid.Row="4" Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,1,0">
                <Button Content="清除" FontSize="15" Foreground="Black" BorderBrush="Black" BorderThickness="1" Width="100" Height="40"></Button>
            </Border>
            <Border Grid.Row="5" Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,1,1">
                <Button Content="清除" FontSize="15" Foreground="Black" BorderBrush="Black" BorderThickness="1" Width="100" Height="40"></Button>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"></RowDefinition>
                <RowDefinition Height="40"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" ></ColumnDefinition>
                <ColumnDefinition Width="50" ></ColumnDefinition>
                <ColumnDefinition Width="250" ></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label Grid.Row="1" Grid.Column="0" Content="磁器口-崇文门                   工况" FontSize="20" Foreground="White" Background="Blue"></Label>
            <Border Grid.Row="2" Grid.Column="0" BorderBrush="Black" BorderThickness="1,0,1,0">
                <Label Content="049009 磁器口-崇文门 左线 靠左" FontSize="20" Foreground="Black" Background="White" Width="480" Height="40"></Label>
            </Border>
            <Border Grid.Row="3" Grid.Column="0" BorderBrush="Black" BorderThickness="1,0,1,0">
                <Label Content="049010 磁器口-崇文门 左线 靠右" FontSize="20" Foreground="Black" Background="White" Width="480" Height="40"></Label>
            </Border>
            <Border Grid.Row="4" Grid.Column="0" BorderBrush="Black" BorderThickness="1,0,1,0">
                <Label Content="049011 磁器口-崇文门 右线 靠左" FontSize="20" Foreground="Black" Background="White" Width="480" Height="40"></Label>
            </Border>
            <Border Grid.Row="5" Grid.Column="0" BorderBrush="Black" BorderThickness="1,0,1,1">
                <Label Content="049012 天磁器口-崇文门 右线 靠右" FontSize="20" Foreground="Black" Background="White" Width="480" Height="40"></Label>
            </Border>
            <Label Grid.Row="1" Grid.Column="1" Content="状态" FontSize="20" Foreground="White" Background="Blue" VerticalContentAlignment="Center"></Label>
            <Border Grid.Row="2" Grid.Column="1" BorderBrush="Black" BorderThickness="1,0,1,0">
                <Label Background="White" Width="40" Height="40"></Label>
            </Border>
            <Border Grid.Row="3" Grid.Column="1" BorderBrush="Black" BorderThickness="1,0,1,0">
                <Label Background="White" Width="40" Height="40"></Label>
            </Border>
            <Border Grid.Row="4" Grid.Column="1" BorderBrush="Black" BorderThickness="1,0,1,0">
                <Label Background="White" Width="40" Height="40"></Label>
            </Border>
            <Border Grid.Row="5" Grid.Column="1" BorderBrush="Black" BorderThickness="1,0,1,1">
                <Label Background="White" Width="40" Height="40"></Label>
            </Border>
            <Label Grid.Row="1" Grid.Column="2" Content="阻塞清除" FontSize="15" Foreground="White" Background="Blue" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"></Label>
            <Border Grid.Row="2" Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,1,0">
                <Button Content="清除" FontSize="15" Foreground="Black" BorderBrush="Black" BorderThickness="1" Width="100" Height="40"></Button>
            </Border>
            <Border Grid.Row="3" Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,1,0">
                <Button Content="清除" FontSize="15" Foreground="Black" BorderBrush="Black" BorderThickness="1" Width="100" Height="40"></Button>
            </Border>
            <Border Grid.Row="4" Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,1,0">
                <Button Content="清除" FontSize="15" Foreground="Black" BorderBrush="Black" BorderThickness="1" Width="100" Height="40"></Button>
            </Border>
            <Border Grid.Row="5" Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,1,1">
                <Button Content="清除" FontSize="15" Foreground="Black" BorderBrush="Black" BorderThickness="1" Width="100" Height="40"></Button>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="100"></RowDefinition>
                <RowDefinition Height="40"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" ></ColumnDefinition>
                <ColumnDefinition Width="320" ></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="IBP控制" FontSize="20" Foreground="Black" VerticalAlignment="Bottom"></TextBlock>
            <Label Grid.Row="1" Grid.Column="0" Content="IBP启动" FontSize="20" Foreground="White" Background="Blue" HorizontalContentAlignment="Center"></Label>
            <Border Grid.Row="2" Grid.Column="0" BorderBrush="Black" BorderThickness="1,0,0,0">
                <Label Background="White" Width="40" Height="40"></Label>
            </Border>
            <Border Grid.Row="3" Grid.Column="0" BorderBrush="Black" BorderThickness="1,0,0,0">
                <Label Background="White" Width="40" Height="40"></Label>
            </Border>
            <Border Grid.Row="4" Grid.Column="0" BorderBrush="Black" BorderThickness="1,0,0,0">
                <Label Background="White" Width="40" Height="40"></Label>
            </Border>
            <Border Grid.Row="5" Grid.Column="0" BorderBrush="Black" BorderThickness="1,0,0,1">
                <Label Background="White" Width="40" Height="40"></Label>
            </Border>
            <Label Grid.Row="1" Grid.Column="1" Background="Blue"></Label>
            <Border Grid.Row="2" Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,0">
                <TextBlock Text="9005---- 下行区间模式1" FontSize="15" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
            </Border>
            <Border Grid.Row="3" Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,0">
                <TextBlock Text="9006---- 下行区间模式2" FontSize="15" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
            </Border>
            <Border Grid.Row="4" Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,0">
                <TextBlock Text="9007---- 上行区间模式1" FontSize="15" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
            </Border>
            <Border Grid.Row="5" Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,1">
                <TextBlock Text="9008---- 上行区间模式1" FontSize="15" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"></RowDefinition>
                <RowDefinition Height="40"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" ></ColumnDefinition>
                <ColumnDefinition Width="320" ></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="IBP控制" FontSize="20" Foreground="Black" VerticalAlignment="Bottom"></TextBlock>
            <Label Grid.Row="1" Grid.Column="0" Content="IBP启动" FontSize="20" Foreground="White" Background="Blue" HorizontalContentAlignment="Center"></Label>
            <Border Grid.Row="2" Grid.Column="0" BorderBrush="Black" BorderThickness="1,0,0,0">
                <Label Background="White" Width="40" Height="40"></Label>
            </Border>
            <Border Grid.Row="3" Grid.Column="0" BorderBrush="Black" BorderThickness="1,0,0,0">
                <Label Background="White" Width="40" Height="40"></Label>
            </Border>
            <Border Grid.Row="4" Grid.Column="0" BorderBrush="Black" BorderThickness="1,0,0,0">
                <Label Background="White" Width="40" Height="40"></Label>
            </Border>
            <Border Grid.Row="5" Grid.Column="0" BorderBrush="Black" BorderThickness="1,0,0,1">
                <Label Background="White" Width="40" Height="40"></Label>
            </Border>
            <Label Grid.Row="1" Grid.Column="1" Background="Blue"></Label>
            <Border Grid.Row="2" Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,0">
                <TextBlock Text="9009---- 下行区间模式3" FontSize="15" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
            </Border>
            <Border Grid.Row="3" Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,0">
                <TextBlock Text="9010---- 下行区间模式4" FontSize="15" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
            </Border>
            <Border Grid.Row="4" Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,0">
                <TextBlock Text="9011---- 上行区间模式3" FontSize="15" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
            </Border>
            <Border Grid.Row="5" Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,1">
                <TextBlock Text="9012---- 上行区间模式4" FontSize="15" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Grid.Column="2" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="90"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10" ></ColumnDefinition>
                <ColumnDefinition Width="210" ></ColumnDefinition>
                <ColumnDefinition Width="20" ></ColumnDefinition>
                <ColumnDefinition Width="160" ></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button Grid.Row="4" Grid.Column="1" Content="区间模式表" FontSize="15" Foreground="Black" Width="200" Height="30" Command="{Binding ClickCommand}" CommandParameter="模式-车站阻塞"></Button>
            <Border Grid.Row="1" Grid.Column="3" Grid.RowSpan="4" BorderBrush="Black" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" ></ColumnDefinition>
                        <ColumnDefinition Width="Auto" ></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="备注" FontSize="20" Foreground="Black" Margin="10,10,0,0"></TextBlock>
                    <Label Grid.Row="1" Grid.Column="0" Background="LightGreen" Height="25" Width="25" Margin="10,10,0,0"></Label>
                    <Label Grid.Row="2" Grid.Column="0" Background="LightBlue" Height="25" Width="25" Margin="10,10,0,0"></Label>
                    <Label Grid.Row="3" Grid.Column="0" Background="Red" Height="25" Width="25" Margin="10,10,0,0"></Label>
                    <Label Grid.Row="4" Grid.Column="0" Background="White" Height="25" Width="25" Margin="10,10,0,10"></Label>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="进行中" FontSize="20" Foreground="Black" Margin="10,10,0,0"></TextBlock>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="启动成功" FontSize="20" Foreground="Black" Margin="10,10,0,0"></TextBlock>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="启动失败" FontSize="20" Foreground="Black" Margin="10,10,0,0"></TextBlock>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="不运行" FontSize="20" Foreground="Black" Margin="10,10,0,10"></TextBlock>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="10"></RowDefinition>
                <RowDefinition Height="40"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" ></ColumnDefinition>
                <ColumnDefinition Width="30" ></ColumnDefinition>
                <ColumnDefinition Width="210" ></ColumnDefinition>
                <ColumnDefinition Width="30" ></ColumnDefinition>
                <ColumnDefinition Width="210" ></ColumnDefinition>
                <ColumnDefinition Width="30" ></ColumnDefinition>
                <ColumnDefinition Width="210" ></ColumnDefinition>
                <ColumnDefinition Width="30" ></ColumnDefinition>
                <ColumnDefinition Width="210" ></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button Grid.Row="1" Grid.Column="0" Content="火灾模式" FontSize="15" Foreground="Black" Width="200" Height="30" Command="{Binding ClickCommand}" CommandParameter="环控-模式"></Button>
            <Button Grid.Row="1" Grid.Column="2" Content="空调大系统，水系统" FontSize="15" Foreground="Black" Width="200" Height="30" Command="{Binding ClickCommand}" CommandParameter="模式-大/水"></Button>
            <Button Grid.Row="1" Grid.Column="4" Content="空调小系统" FontSize="15" Foreground="Black" Width="200" Height="30" Command="{Binding ClickCommand}" CommandParameter="模式-小系统"></Button>
            <Button Grid.Row="1" Grid.Column="6" Content="动照，电梯系统" FontSize="15" Foreground="Black" Width="200" Height="30" Command="{Binding ClickCommand}" CommandParameter="模式-电力"></Button>
            <Button Grid.Row="1" Grid.Column="8" Content="区间阻塞模式" FontSize="15" Foreground="Black" Width="200" Height="30" Background="Orange"></Button>
        </Grid>
    </Grid>
</UserControl>
