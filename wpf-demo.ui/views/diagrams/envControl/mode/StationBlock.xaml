            <Border Grid.Row="12" Grid.Column="18" BorderBrush="Black" BorderThickness="1">
            </Border>
            <Border Grid.Row="13" Grid.Column="18" BorderBrush="Black" BorderThickness="1">
                <TextBlock FontSize="20" Text="打开" Foreground="Black" VerticalAlignment="Center" HorizontalAlignment="Left"></TextBlock>
            </Border>
            <Border Grid.Row="14" Grid.Column="18" BorderBrush="Black" BorderThickness="1">
                <TextBlock FontSize="20" Text="无效" Foreground="White" Background="Blue" VerticalAlignment="Center" HorizontalAlignment="Left"></TextBlock>
            </Border>
        </Grid>
        
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="下一页" FontSize="15" Foreground="Black" Width="200" Height="30" Command="{Binding NextPageClickCommand}" Visibility="{Binding FirstPageVisibility}"></Button>
            <Button Content="蒲--天区间设备" FontSize="15" Foreground="Black" Width="200" Height="30" Command="{Binding ClickCommand}" CommandParameter="" Margin="10,0,0,0" Visibility="{Binding FirstPageVisibility}"></Button>
            <Button Content="上一页" FontSize="15" Foreground="Black" Width="200" Height="30" Command="{Binding PreviousPageClickCommand}" Margin="10,0,0,0" Visibility="{Binding SecondPageVisibility}"></Button>
            <Button Content="阻塞模式" FontSize="15" Foreground="Black" Width="200" Height="30" Command="{Binding ClickCommand}" CommandParameter="模式-区间" Margin="10,0,0,0"></Button>
        </StackPanel>
    </Grid>
</UserControl>
