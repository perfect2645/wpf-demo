                <Border Grid.Row="4" Grid.Column="4" BorderBrush="Black" BorderThickness="1,0,0,1">
                    <Label Background="White" Height="30" Width="30" Margin="10,10,0,10"></Label>
                </Border>
                <Border Grid.Row="1" Grid.Column="5" BorderBrush="Black" BorderThickness="0,0,1,0">
                    <TextBlock Text="进行中" FontSize="20" Foreground="Black" Margin="10,10,0,0"></TextBlock>
                </Border>
                <Border Grid.Row="2" Grid.Column="5" BorderBrush="Black" BorderThickness="0,0,1,0">
                    <TextBlock Text="启动成功" FontSize="20" Foreground="Black" Margin="10,10,0,0"></TextBlock>
                </Border>
                <Border Grid.Row="3" Grid.Column="5" BorderBrush="Black" BorderThickness="0,0,1,0">
                    <TextBlock Text="启动失败" FontSize="20" Foreground="Black" Margin="10,10,0,0"></TextBlock>
                </Border>
                <Border Grid.Row="4" Grid.Column="5" BorderBrush="Black" BorderThickness="0,0,1,1">
                    <TextBlock Text="不运行" FontSize="20" Foreground="Black" Margin="10,10,0,0"></TextBlock>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
