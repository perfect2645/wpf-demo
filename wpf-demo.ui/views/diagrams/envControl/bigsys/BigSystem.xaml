<UserControl x:Class="wpf.ui.views.diagrams.envControl.BigSystem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:wpf.ui.views.diagrams.envControl">
    <UserControl.Resources>
    </UserControl.Resources>
    <Grid>
        <local:BigSystemNorthern x:Name="Northern">
            <local:BigSystemNorthern.Style>
                <Style TargetType="local:BigSystemNorthern">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsShowSouthern}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </local:BigSystemNorthern.Style>
        </local:BigSystemNorthern>

        <local:BigSystemSouthern x:Name="Southern">
            <local:BigSystemSouthern.Style>
                <Style TargetType="local:BigSystemSouthern">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsShowSouthern}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </local:BigSystemSouthern.Style>
        </local:BigSystemSouthern>
    </Grid>
</UserControl>
