<Window x:Class="wpf.ui.views.diagrams.envControl.bigsys.ZSFDeviceControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpf.ui.views.diagrams.envControl.bigsys"
        mc:Ignorable="d"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#FFDAD9D8"
        Height="300"
        Width="800">
    <Window.Resources>
        <Style TargetType="Button" x:Key="zsfButtonStyle">
            <Setter Property="Template" Value="{StaticResource ButtonStyle}"/>
        </Style>

        <ControlTemplate x:Key="ButtonStyle" TargetType="Button">
            <Grid Style="{StaticResource MenuButtonGrid}">
                <Canvas>
                    <Path Fill="#FF2C2918" StrokeThickness="1" Data="F1M115.8,0L109.45,5.3 6.3,45.8 0,51 115.8,51 115.8,0z"/>
                    <Path Fill="#FFF0F0F0" StrokeThickness="1" Data="F1M109.45,5.3L115.8,0 0,0 0,51 6.3,45.8 109.45,5.3z"/>
                </Canvas>
                <Canvas>
                    <Canvas.RenderTransform>
                        <MatrixTransform Matrix="0.9808349609375 0 0 0.964279174804688 -241.850006103516 -43"/>
                    </Canvas.RenderTransform>
                    <Canvas>
                        <Canvas Name="___1_0_Layer0_0_MEMBER_1_FILL">
                            <Path Fill="#FFDAD9D8" StrokeThickness="1" Data="F1M358.1,92.05L358.1,50.05 253.1,50.05 253.1,92.05 358.1,92.05z"/>
                        </Canvas>
                    </Canvas>
                </Canvas>
                <TextBlock x:Name="PART_TextBlock"
                Text="{TemplateBinding Content}"
                       Padding="10"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap" >
                </TextBlock>
            </Grid>
        </ControlTemplate>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="_____Regular"/>
            <Setter Property="FontSize" Value='30'/>
            <Setter Property="Foreground" Value="#FF333333"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                <TextBlock Text="点名：" />
                <TextBlock Text="ttd_bas_zsf_ii_rs" Background="Blue"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,10,0,0">
                <TextBlock Text="描述："/>
                <TextBlock Text="天坛东 - 北端风道轴凌送风机ZSF-II" Background="Blue"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Row="2"  Margin="0,10,0,0">
                <TextBlock Text="状态："/>
                <TextBlock Text="正向" Background="Blue"/>
            </StackPanel>

            <Button Grid.RowSpan="3" Grid.Column="1" 
                    HorizontalAlignment="Right"
                    Style="{StaticResource zsfButtonStyle}"
                    VerticalAlignment="Bottom" Content="Alarm&#x0a;Schedule"></Button>
        </Grid>

        <StackPanel Orientation="Horizontal" Grid.Row="1" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Bottom"
                    Margin="10">
            <Button Style="{StaticResource zsfButtonStyle}" Content="控制">
            </Button>
            <Button Style="{StaticResource zsfButtonStyle}" Content="标记">
            </Button>
            <Button Style="{StaticResource zsfButtonStyle}" Content="详情">
            </Button>
            <Button Style="{StaticResource zsfButtonStyle}" Content="指派&#x0a;趋势">
            </Button>
            <Button Style="{StaticResource zsfButtonStyle}" Content="报警&#x0a;时间表">
            </Button>
            <Button Style="{StaticResource zsfButtonStyle}" Content="取消">
            </Button>
        </StackPanel>
    </Grid>

</Window>
