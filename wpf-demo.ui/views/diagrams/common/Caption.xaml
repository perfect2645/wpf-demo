<UserControl x:Class="wpf.ui.views.diagrams.common.Caption"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:wpf.ui.views.diagrams.common"
             x:Name="CaptionCtrl">
    <StackPanel Orientation="Horizontal"
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
        <TextBlock 
                FontWeight="Normal"
                Text="{Binding StationName, ElementName=CaptionCtrl}">
        </TextBlock>
        <TextBlock 
                FontWeight="Normal"
                Text="{Binding CaptionText, ElementName=CaptionCtrl}">
        </TextBlock>
    </StackPanel>
</UserControl>
