<UserControl x:Class="UserComponent.Core.station.StationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UserComponent.Core.station"
             xmlns:converter="clr-namespace:WpfUtils.Converters;assembly=WpfUtils"
             x:Name="StationCtrl">
    <UserControl.Resources>
        <ResourceDictionary>
            <converter:BoolToVisibilityConverter x:Key="VisibilityToBoolConverter" />
            <converter:TextPaddingConverter x:Key="TextPaddingConverter" />

            <Style TargetType="Button" x:Key="StationBtnStyle">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Button x:Name="InnerButton"
                            Content="{TemplateBinding Content}"
                            Template="{Binding NormalTemplate, ElementName=StationCtrl}"/>

                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="InnerButton" 
                                        Property="Template" 
                                        Value="{Binding PressedTemplate, ElementName=StationCtrl}"/>
                                </DataTrigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="InnerButton" Property="IsEnabled" Value="False"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Canvas>
            <Line x:Name="connectLine" Style="{DynamicResource StationLineStyle}"
                X1="{Binding LineX1, ElementName=StationCtrl}"
                Y1="{Binding LineY1, ElementName=StationCtrl}"
                X2="{Binding LineX2, ElementName=StationCtrl}"
                Y2="{Binding LineY2, ElementName=StationCtrl}" 
                Visibility="{Binding ShowLine, ElementName=StationCtrl, Converter={StaticResource VisibilityToBoolConverter}}"/>
        </Canvas>
        <StackPanel>
            <TextBlock Text="{Binding Title, ElementName=StationCtrl}">
                <TextBlock.Padding>
                    <MultiBinding Converter="{StaticResource TextPaddingConverter}">
                        <Binding Path="Text" RelativeSource="{RelativeSource Self}" />
                        <Binding Path="FontSize" RelativeSource="{RelativeSource Self}" />
                        <Binding Path="PaddingOffset" ElementName="StationCtrl" />
                    </MultiBinding>
                </TextBlock.Padding>
            </TextBlock>
            <Button Style="{StaticResource StationBtnStyle}"
                Click="Button_Click">
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
