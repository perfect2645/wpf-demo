<Window x:Class="PowerComponent.Core.Popup.PopupBase"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding DialogTitle}"
        Background="Transparent">

    <Border BorderThickness="1" BorderBrush="#333" Background="White" CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"
                Height="40" Background="#f0f0f0">
                <TextBlock Text="{Binding DialogTitle}" Margin="10,0" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                <Button Content="×" Width="40" Height="40" HorizontalAlignment="Right" 
                        Command="{Binding CloseCommand}" />
            </Grid>

            <ContentControl Grid.Row="1"
                x:Name="PART_Content" Margin="10" 
                Content="{Binding DialogContent}" />

            <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="10" HorizontalAlignment="Right">
                <Button Content="取消" Width="80" Command="{Binding CancelCommand}"/>
                <Button Content="确定" Width="80" Command="{Binding ConfirmCommand}" Background="#0078d7" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
